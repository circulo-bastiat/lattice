{
  "extraKnownMarketplaces": { "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } } },
  "enabledPlugins": { "ponytail@ponytail": true },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(sed *)",
      "PowerShell(node *)",
      "PowerShell(git *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Select-String *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Test-Path *)",
      "PowerShell(New-Item *)",
      "PowerShell(Move-Item *)",
      "PowerShell(Copy-Item *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "ScheduleWakeup",
      "Monitor",
      "CronCreate",
      "TaskOutput",
      "BashOutput",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "Bash(sleep *)",
      "Bash(watch *)",
      "Bash(nohup *)",
      "Bash(timeout *)",
      "PowerShell(Start-Sleep*)",
      "PowerShell(Wait-Process*)",
      "PowerShell(Wait-Job*)",
      "PowerShell(Start-Job*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/infra/mailhook.mjs",
            "timeout": 25
          }
        ]
      }
    ]
  }
}
